msgstr "Kies terrein"

#: include/arrays.php
msgid "Date and time of tag"
msgstr "Datum en tyd van merker"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Die datum / tyd vir hierdie merker."

#: include/arrays.php
msgid "Choose color"
msgstr "Kies kleur"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Kies kleur vir hierdie merker"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Aktiveer"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Gedeaktiveerde merker sal nie in die grafiek vertoon word nie."

#: include/arrays.php
msgid "Settings"
msgstr "Instellings"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Versteek merkers in grafieke"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Indien gemerk, sal die inprop nie merkers in grafieke vertoon nie"

#: include/arrays.php
msgid "Data Retention"
msgstr "Databehoud"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Na hierdie tyd sal merkers na die argief geskuif word en nie meer vertoon word nie"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Grafieklegende-limiet"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "As die aantal merkers groter as die limiet is, sal die legende saamgevoeg word. Weens moontlike vertoonprobleme word die aantal vertikale lyne tot 5 keer hierdie waarde beperk."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Kies primêre toestel"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Gewoonlik 'n plaaslike Cacti-toestel. Merkers wat verband hou met die Cacti-stelsel sal hier vertoon word."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Outomatiese merkers - gasheerspesifiek"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Outomatiese merker vir gasheerherbegin"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Indien gemerk, sal die inprop 'n outomatiese merker skep wanneer die toestel herbegin"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Merkerkleur vir gasheerherbegin"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Aanbeveling: Gebruik 'n ander kleur vir elke outomatiese merker"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Outomatiese merker vir bygevoegde gasheer. Sal op die 'Verstek'-toestel en die spesifieke toestel vertoon word"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Indien gemerk, sal die inprop outomatiese merkers skep wanneer 'n toestel bygevoeg word"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Merkerkleur vir bygevoegde gasheer"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Outomatiese merker vir stoor/wysiging van toestel"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Indien gemerk, sal die inprop 'n outomatiese merker skep wanneer 'n toestel gestoor (gewysig) word"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Merkerkleur vir stoor/wysiging van toestel"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Outomatiese merker vir herindeksering van databron"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Skep 'n merker wanneer die stel indekse wat deur 'n toesteldatanavraag teruggestuur word, verander."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Merkerkleur vir herindeksering van databron"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Outomatiese merkers - ander"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Kies hoe om die merkers hieronder te vertoon"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Vir watter toestelle sal die merkers hieronder vertoon word?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Outomatiese merker vir Cacti-weergawe"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Indien gemerk, sal die inprop 'n outomatiese merker skep wanneer die Cacti-weergawe verander. Die merker is vir alle grafieke."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Merkerkleur vir Cacti-weergawe"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Outomatiese merker vir peiler-oorloop"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Skep 'n merker wanneer 'n dataversamelaar se peilingsiklus die gekonfigureerde peilingsinterval oorskry."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Merkerkleur vir peiler-oorloop"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Outomatiese merkers vir dataversamelaarstatus"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Skep merkers wanneer 'n afgeleë dataversamelaar afgaan of herstel."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Merkerkleur vir dataversamelaarstatus"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Outomatiese merker vir inpropstatus"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Skep 'n merker wanneer enige inprop se status verander (aktiveer/deaktiveer/opgradeer)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Merkerkleur vir inproptoestand"

