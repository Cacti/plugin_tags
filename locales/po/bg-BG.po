msgstr "Изберете обект"

#: include/arrays.php
msgid "Date and time of tag"
msgstr "Дата и час на етикета"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Датата / часът за този етикет."

#: include/arrays.php
msgid "Choose color"
msgstr "Изберете цвят"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Изберете цвят за този етикет"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Включи"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Изключеният етикет няма да се показва в графиката."

#: include/arrays.php
msgid "Settings"
msgstr "Настройки"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Скрий етикетите в графиките"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ако е отметнато, приставката няма да показва етикети в графиките"

#: include/arrays.php
msgid "Data Retention"
msgstr "Запазване на данни"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "След това време етикетите ще бъдат преместени в архива и вече няма да се показват"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Ограничение на легендата на графиката"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ако броят на етикетите е по-голям от ограничението, легендата ще бъде обединена. Поради възможни проблеми с показването броят на вертикалните линии е ограничен до 5 пъти тази стойност."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Изберете основно устройство"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Обикновено локално устройство на Cacti. Етикетите, свързани със системата Cacti, ще се показват тук."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Автоматични етикети - специфични за хоста"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Автоматичен етикет при рестартиране на хост"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ако е отметнато, приставката ще създава автоматичен етикет при рестартиране на устройството"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Цвят на етикета при рестартиране на хост"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Препоръка: Използвайте различен цвят за всеки автоматичен етикет"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Автоматичен етикет при добавяне на хост. Ще се показва на устройството 'По подразбиране' и на конкретното устройство"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ако е отметнато, приставката ще създава автоматични етикети при добавяне на устройство"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Цвят на етикета при добавяне на хост"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Автоматичен етикет при запазване/промяна на устройство"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ако е отметнато, приставката ще създава автоматичен етикет при запазване (промяна) на устройство"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Цвят на етикета при запазване/промяна на устройство"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Автоматичен етикет при преиндексиране на източник на данни"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Създава етикет, когато се промени наборът от индекси, върнати от заявка за данни на устройство."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Цвят на етикета при преиндексиране на източник на данни"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Автоматични етикети - други"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Изберете как да се показват изброените по-долу етикети"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "За кои устройства ще се показват етикетите по-долу?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Автоматичен етикет за версия на Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ако е отметнато, приставката ще създава автоматичен етикет при промяна на версията на Cacti. Етикетът е за всички графики."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Цвят на етикета за версия на Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Автоматичен етикет при превишаване на времето на полера"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Създава етикет, когато цикълът на събиране на данни на събирача превиши конфигурирания интервал на полера."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Цвят на етикета при превишаване на времето на полера"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Автоматични етикети за състояние на събирача на данни"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Създава етикети, когато отдалечен събирач на данни спре да работи или се възстанови."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Цвят на етикета за състояние на събирача на данни"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Автоматичен етикет за състояние на приставка"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Създава етикет при промяна на състоянието на която и да е приставка (включване/изключване/надграждане)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Цвят на етикета за състояние на приставка"

