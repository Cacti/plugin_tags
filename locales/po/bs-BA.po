#: include/arrays.php tags.php
msgid "Enable"
msgstr "Omogući"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Onemogućena oznaka neće biti prikazana na grafikonu."

#: include/arrays.php
msgid "Settings"
msgstr "Postavke"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Sakrij oznake na grafikonima"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ako je označeno, dodatak neće prikazivati oznake na grafikonima"

#: include/arrays.php
msgid "Data Retention"
msgstr "Zadržavanje podataka"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Nakon ovog vremena oznake će biti premještene u arhivu i više neće biti prikazane"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Ograničenje legende grafikona"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ako je broj oznaka veći od ograničenja, legenda će biti objedinjena. Zbog mogućih problema s prikazom, broj vertikalnih linija ograničen je na 5 puta ove vrijednosti."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Odaberite primarni uređaj"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Obično lokalni Cacti uređaj. Oznake povezane sa Cacti sistemom bit će prikazane ovdje."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automatske oznake - specifične za host"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatska oznaka za ponovno pokretanje hosta"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ako je označeno, dodatak će kreirati automatsku oznaku kada se uređaj ponovo pokrene"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Boja oznake za ponovno pokretanje hosta"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Preporuka: Koristite drugu boju za svaku automatsku oznaku"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatska oznaka za dodani host. Bit će prikazana na uređaju 'Podrazumijevano' i na određenom uređaju"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ako je označeno, dodatak će kreirati automatske oznake kada se uređaj doda"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Boja oznake za dodani host"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatska oznaka za spremanje/izmjenu uređaja"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ako je označeno, dodatak će kreirati automatsku oznaku kada se uređaj spremi (izmijeni)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Boja oznake za spremanje/izmjenu uređaja"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatska oznaka za ponovno indeksiranje izvora podataka"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Kreira oznaku kada se promijeni skup indeksa koje vraća upit za podatke uređaja."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Boja oznake za ponovno indeksiranje izvora podataka"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automatske oznake - ostalo"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Odaberite kako prikazati oznake navedene ispod"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Za koje uređaje će biti prikazane oznake ispod?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatska oznaka za verziju Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ako je označeno, dodatak će kreirati automatsku oznaku kada se promijeni verzija Cacti. Oznaka važi za sve grafikone."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Boja oznake za verziju Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatska oznaka za prekoračenje vremena pollera"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Kreira oznaku kada ciklus prikupljanja podataka sakupljača prekorači podešeni interval pollera."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Boja oznake za prekoračenje vremena pollera"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatske oznake za status sakupljača podataka"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Kreira oznake kada udaljeni sakupljač podataka prestane raditi ili se oporavi."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Boja oznake za status sakupljača podataka"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatska oznaka za status dodatka"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Kreira oznaku kada se promijeni status bilo kojeg dodatka (omogući/onemogući/nadogradi)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Boja oznake za stanje dodatka"

