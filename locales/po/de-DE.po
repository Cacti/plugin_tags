msgstr "Farbe für dieses Tag auswählen"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Aktivieren"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Ein deaktiviertes Tag wird nicht im Diagramm angezeigt."

#: include/arrays.php
msgid "Settings"
msgstr "Einstellungen"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Tags in Diagrammen ausblenden"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Wenn aktiviert, zeigt das Plugin keine Tags in Diagrammen an"

#: include/arrays.php
msgid "Data Retention"
msgstr "Datenaufbewahrung"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Nach dieser Zeit werden Tags ins Archiv verschoben und nicht mehr angezeigt"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Limit für Diagrammlegende"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Wenn die Anzahl der Tags größer als das Limit ist, wird die Legende zusammengefasst. Aufgrund möglicher Darstellungsprobleme ist die Anzahl der vertikalen Linien auf das 5-Fache dieses Wertes begrenzt."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Primäres Gerät auswählen"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Typischerweise ein lokales Cacti-Gerät. Tags zum Cacti-System werden hier angezeigt."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automatische Tags - hostspezifisch"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatisches Tag bei Host-Neustart"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Wenn aktiviert, erstellt das Plugin ein automatisches Tag, wenn das Gerät neu startet"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Tag-Farbe für Host-Neustart"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Empfehlung: Verwenden Sie für jedes automatische Tag eine andere Farbe"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatisches Tag bei hinzugefügtem Host. Wird beim Gerät 'Standard' und dem jeweiligen Gerät angezeigt"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Wenn aktiviert, erstellt das Plugin automatische Tags, wenn ein Gerät hinzugefügt wird"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Tag-Farbe für hinzugefügten Host"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatisches Tag bei Gerätespeicherung/-änderung"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Wenn aktiviert, erstellt das Plugin ein automatisches Tag, wenn ein Gerät gespeichert (geändert) wird"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Tag-Farbe für Gerätespeicherung/-änderung"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatisches Tag bei Neuindizierung einer Datenquelle"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Ein Tag erstellen, wenn sich die Menge der von einer Geräte-Datenabfrage zurückgegebenen Indizes ändert."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Tag-Farbe für Datenquellen-Neuindizierung"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automatische Tags - sonstige"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Auswählen, wie die unten aufgeführten Tags angezeigt werden"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Für welche Geräte sollen die unten aufgeführten Tags angezeigt werden?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatisches Tag bei Cacti-Version"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Wenn aktiviert, erstellt das Plugin ein automatisches Tag, wenn sich die Cacti-Version ändert. Das Tag gilt für alle Diagramme."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Tag-Farbe für Cacti-Version"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatisches Tag bei Poller-Zeitüberschreitung"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Ein Tag erstellen, wenn ein Abfragezyklus eines Datensammlers das konfigurierte Poller-Intervall überschreitet."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Tag-Farbe für Poller-Zeitüberschreitung"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatische Tags für Datensammler-Status"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Tags erstellen, wenn ein entfernter Datensammler ausfällt oder wiederhergestellt wird."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Tag-Farbe für Datensammler-Status"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatisches Tag für Plugin-Status"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Ein Tag erstellen, wenn sich der Status eines Plugins ändert (Aktivieren/Deaktivieren/Aktualisieren)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Tag-Farbe für Plugin-Status"

