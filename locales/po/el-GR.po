msgstr "Η ημερομηνία / ώρα για αυτήν την ετικέτα."

#: include/arrays.php
msgid "Choose color"
msgstr "Επιλογή χρώματος"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Επιλέξτε χρώμα για αυτήν την ετικέτα"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Ενεργοποίηση"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Μια απενεργοποιημένη ετικέτα δεν θα εμφανίζεται στο γράφημα."

#: include/arrays.php
msgid "Settings"
msgstr "Ρυθμίσεις"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Απόκρυψη ετικετών στα γραφήματα"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Εάν επιλεγεί, το πρόσθετο δεν θα εμφανίζει ετικέτες στα γραφήματα"

#: include/arrays.php
msgid "Data Retention"
msgstr "Διατήρηση δεδομένων"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Μετά από αυτό το διάστημα, οι ετικέτες θα μεταφέρονται στο αρχείο και δεν θα εμφανίζονται πλέον"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Όριο υπομνήματος γραφήματος"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Εάν ο αριθμός των ετικετών υπερβαίνει το όριο, το υπόμνημα θα ομαδοποιείται. Λόγω πιθανών προβλημάτων εμφάνισης, ο αριθμός των κατακόρυφων γραμμών περιορίζεται στο 5πλάσιο αυτής της τιμής."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Επιλογή κύριας συσκευής"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Συνήθως μια τοπική συσκευή Cacti. Οι ετικέτες που σχετίζονται με το σύστημα Cacti θα εμφανίζονται εδώ."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Αυτόματες ετικέτες - ανά συσκευή"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Αυτόματη ετικέτα επανεκκίνησης κεντρικού υπολογιστή"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Εάν επιλεγεί, το πρόσθετο θα δημιουργεί αυτόματη ετικέτα κατά την επανεκκίνηση της συσκευής"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Χρώμα ετικέτας επανεκκίνησης κεντρικού υπολογιστή"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Σύσταση: Χρησιμοποιήστε διαφορετικό χρώμα για κάθε αυτόματη ετικέτα"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Αυτόματη ετικέτα προσθήκης κεντρικού υπολογιστή. Θα εμφανίζεται στην 'Προεπιλογή' συσκευή και στη συγκεκριμένη συσκευή"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Εάν επιλεγεί, το πρόσθετο θα δημιουργεί αυτόματες ετικέτες όταν προστίθεται μια συσκευή"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Χρώμα ετικέτας προσθήκης κεντρικού υπολογιστή"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Αυτόματη ετικέτα αποθήκευσης/αλλαγής συσκευής"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Εάν επιλεγεί, το πρόσθετο θα δημιουργεί αυτόματη ετικέτα όταν αποθηκεύεται (τροποποιείται) μια συσκευή"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Χρώμα ετικέτας αποθήκευσης/αλλαγής συσκευής"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Αυτόματη ετικέτα επαναευρετηρίασης πηγής δεδομένων"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Δημιουργία ετικέτας όταν αλλάζει το σύνολο των δεικτών που επιστρέφει ένα ερώτημα δεδομένων συσκευής."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Χρώμα ετικέτας επαναευρετηρίασης πηγής δεδομένων"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Αυτόματες ετικέτες - άλλες"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Επιλέξτε πώς θα εμφανίζονται οι παρακάτω ετικέτες"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Για ποιες συσκευές θα εμφανίζονται οι παρακάτω ετικέτες;"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Αυτόματη ετικέτα έκδοσης Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Εάν επιλεγεί, το πρόσθετο θα δημιουργεί αυτόματη ετικέτα όταν αλλάζει η έκδοση του Cacti. Η ετικέτα ισχύει για όλα τα γραφήματα."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Χρώμα ετικέτας έκδοσης Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Αυτόματη ετικέτα υπέρβασης χρόνου Poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Δημιουργία ετικέτας όταν ένας κύκλος δειγματοληψίας ενός συλλέκτη δεδομένων υπερβαίνει το διαμορφωμένο διάστημα του poller."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Χρώμα ετικέτας υπέρβασης χρόνου Poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Αυτόματες ετικέτες κατάστασης συλλέκτη δεδομένων"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Δημιουργία ετικετών όταν ένας απομακρυσμένος συλλέκτης δεδομένων τίθεται εκτός λειτουργίας ή επανέρχεται."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Χρώμα ετικέτας κατάστασης συλλέκτη δεδομένων"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Αυτόματη ετικέτα κατάστασης πρόσθετου"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Δημιουργία ετικέτας όταν αλλάζει η κατάσταση οποιουδήποτε πρόσθετου (ενεργοποίηση/απενεργοποίηση/αναβάθμιση)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Χρώμα ετικέτας κατάστασης πρόσθετου"

