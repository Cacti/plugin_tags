msgid "Enable"
msgstr "Activer"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Une étiquette désactivée ne sera pas affichée dans le graphique."

#: include/arrays.php
msgid "Settings"
msgstr "Paramètres"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Masquer les étiquettes dans les graphiques"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Si coché, le plugin n'affichera pas les étiquettes dans les graphiques"

#: include/arrays.php
msgid "Data Retention"
msgstr "Conservation des données"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Passé ce délai, les étiquettes seront déplacées vers l'archive et ne seront plus affichées"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Limite de la légende du graphique"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Si le nombre d'étiquettes dépasse cette limite, la légende sera agrégée. En raison de problèmes d'affichage potentiels, le nombre de lignes verticales est limité à 5 fois cette valeur."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Sélectionner l'équipement principal"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Généralement un équipement Cacti local. Les étiquettes liées au système Cacti seront affichées ici."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Étiquettes automatiques - propres à l'hôte"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Étiquette automatique de redémarrage d'hôte"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Si coché, le plugin créera une étiquette automatique lors du redémarrage d'un équipement"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Couleur d'étiquette de redémarrage d'hôte"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Recommandation : utilisez une couleur différente pour chaque étiquette automatique"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Étiquette automatique d'ajout d'hôte. Sera affichée sur l'équipement 'Par défaut' et sur l'équipement concerné"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Si coché, le plugin créera des étiquettes automatiques lorsqu'un équipement est ajouté"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Couleur d'étiquette d'ajout d'hôte"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Étiquette automatique d'enregistrement/modification d'équipement"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Si coché, le plugin créera une étiquette automatique lorsqu'un équipement est enregistré (modifié)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Couleur d'étiquette d'enregistrement/modification d'équipement"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Étiquette automatique de réindexation de source de données"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Créer une étiquette lorsque l'ensemble des index renvoyés par une requête de données d'équipement change."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Couleur d'étiquette de réindexation de source de données"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Étiquettes automatiques - autres"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Choisir comment afficher les étiquettes listées ci-dessous"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Pour quels équipements les étiquettes ci-dessous seront-elles affichées ?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Étiquette automatique de version de Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Si coché, le plugin créera une étiquette automatique lorsque la version de Cacti change. L'étiquette s'applique à tous les graphiques."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Couleur d'étiquette de version de Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Étiquette automatique de dépassement du poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Créer une étiquette lorsqu'un cycle d'interrogation d'un collecteur de données dépasse l'intervalle configuré du poller."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Couleur d'étiquette de dépassement du poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Étiquettes automatiques d'état du collecteur de données"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Créer des étiquettes lorsqu'un collecteur de données distant tombe en panne ou se rétablit."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Couleur d'étiquette d'état du collecteur de données"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Étiquette automatique d'état de plugin"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Créer une étiquette lorsque l'état d'un plugin change (activer/désactiver/mettre à niveau)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Couleur d'étiquette d'état de plugin"

