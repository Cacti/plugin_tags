msgstr "Kwanan wata da lokacin alama"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Kwanan wata / lokaci na wannan alama."

#: include/arrays.php
msgid "Choose color"
msgstr "Zaɓi launi"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Zaɓi launi don wannan alama"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Kunna"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Ba za a nuna alamar da aka kashe a cikin jadawali ba."

#: include/arrays.php
msgid "Settings"
msgstr "Saituna"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ɓoye alamomi a cikin jadawalai"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Idan aka zaɓa, ƙarin manhajar ba zai nuna alamomi a cikin jadawalai ba"

#: include/arrays.php
msgid "Data Retention"
msgstr "Ajiyar Bayanai"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Bayan wannan lokaci, za a mayar da alamomi zuwa rumbun ajiya kuma ba za a ƙara nuna su ba"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Iyakar bayanin jadawali"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Idan adadin alamomi ya wuce iyaka, za a haɗa bayanin jadawalin wuri guda. Saboda yuwuwar matsalolin nuni, adadin layuka masu tsaye yana iyakance ne zuwa ninki 5 na wannan adadi."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Zaɓi Babbar Na'ura"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Yawanci na'urar Cacti ta cikin gida ce. Za a nuna alamomin da suka shafi tsarin Cacti a nan."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Alamomin kai tsaye - na musamman ga na'ura"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Alamar kai tsaye ta sake fara na'ura"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Idan aka zaɓa, ƙarin manhajar zai ƙirƙiri alamar kai tsaye lokacin da na'ura ta sake farawa"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Launin alamar sake fara na'ura"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Shawara: Yi amfani da launi daban don kowace alamar kai tsaye"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Alamar kai tsaye ta ƙara na'ura. Za a nuna ta a na'urar 'Na Asali' da takamaiman na'urar"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Idan aka zaɓa, ƙarin manhajar zai ƙirƙiri alamomin kai tsaye lokacin da aka ƙara na'ura"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Launin alamar ƙara na'ura"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Alamar kai tsaye ta ajiye/canza na'ura"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Idan aka zaɓa, ƙarin manhajar zai ƙirƙiri alamar kai tsaye lokacin da aka ajiye (canza) na'ura"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Launin alamar ajiye/canza na'ura"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Alamar kai tsaye ta sake jera tushen bayanai"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Ƙirƙiri alama lokacin da jerin fihirisar da binciken bayanan na'ura ke dawowa ya canza."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Launin alamar sake jera tushen bayanai"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Alamomin kai tsaye - sauran"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Zaɓi yadda za a nuna alamomin da aka jera a ƙasa"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Ga waɗanne na'urori ne za a nuna alamomin da ke ƙasa?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Alamar kai tsaye ta sigar Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Idan aka zaɓa, ƙarin manhajar zai ƙirƙiri alamar kai tsaye lokacin da aka canza sigar Cacti. Alamar ta shafi dukkan jadawalai ne."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Launin alamar sigar Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Alamar kai tsaye ta wucewar lokacin poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Ƙirƙiri alama lokacin da zagayen tattara bayanai na mai tattara bayanai ya wuce tazarar lokacin poller da aka saita."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Launin alamar wucewar lokacin poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Alamomin kai tsaye na matsayin mai tattara bayanai"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Ƙirƙiri alamomi lokacin da mai tattara bayanai na nesa ya daina aiki ko ya dawo aiki."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Launin alamar matsayin mai tattara bayanai"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Alamar kai tsaye ta matsayin ƙarin manhaja"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Ƙirƙiri alama lokacin da matsayin kowane ƙarin manhaja ya canza (kunna/kashe/haɓaka)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Launin alamar yanayin ƙarin manhaja"

