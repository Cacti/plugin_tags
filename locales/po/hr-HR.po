msgid "Settings"
msgstr "Postavke"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Sakrij oznake u grafikonima"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ako je označeno, dodatak neće prikazivati oznake u grafikonima"

#: include/arrays.php
msgid "Data Retention"
msgstr "Zadržavanje podataka"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Nakon ovog vremena oznake će biti premještene u arhivu i više se neće prikazivati"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Ograničenje legende grafikona"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ako je broj oznaka veći od ograničenja, legenda će biti sažeta. Zbog mogućih problema s prikazom, broj okomitih linija ograničen je na 5 puta ove vrijednosti."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Odaberite primarni uređaj"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Obično lokalni Cacti uređaj. Oznake povezane sa sustavom Cacti prikazivat će se ovdje."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automatske oznake - specifične za poslužitelj"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatska oznaka ponovnog pokretanja poslužitelja"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ako je označeno, dodatak će stvoriti automatsku oznaku kada se uređaj ponovno pokrene"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Boja oznake ponovnog pokretanja poslužitelja"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Preporuka: Koristite različitu boju za svaku automatsku oznaku"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatska oznaka dodavanja poslužitelja. Prikazivat će se na uređaju 'Zadano' i na određenom uređaju"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ako je označeno, dodatak će stvoriti automatske oznake kada se uređaj doda"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Boja oznake dodavanja poslužitelja"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatska oznaka spremanja/izmjene uređaja"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ako je označeno, dodatak će stvoriti automatsku oznaku kada se uređaj spremi (izmijeni)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Boja oznake spremanja/izmjene uređaja"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatska oznaka ponovnog indeksiranja izvora podataka"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Stvori oznaku kada se promijeni skup indeksa koje vraća upit za podatke uređaja."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Boja oznake ponovnog indeksiranja izvora podataka"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automatske oznake - ostalo"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Odaberite način prikaza dolje navedenih oznaka"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Za koje će se uređaje prikazivati dolje navedene oznake?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatska oznaka verzije Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ako je označeno, dodatak će stvoriti automatsku oznaku kada se promijeni verzija Cacti. Oznaka vrijedi za sve grafikone."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Boja oznake verzije Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatska oznaka prekoračenja vremena pollera"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Stvori oznaku kada ciklus prikupljanja podataka premaši konfigurirani interval pollera."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Boja oznake prekoračenja vremena pollera"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatske oznake statusa prikupljača podataka"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Stvori oznake kada udaljeni prikupljač podataka prestane raditi ili se oporavi."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Boja oznake statusa prikupljača podataka"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatska oznaka statusa dodatka"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Stvori oznaku kada se promijeni status bilo kojeg dodatka (omogućivanje/onemogućivanje/nadogradnja)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Boja oznake stanja dodatka"

