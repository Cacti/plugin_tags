#: include/arrays.php tags.php
msgid "Enable"
msgstr "Gbanye"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Agaghị egosi mkpado agbanyụrụ na eserese."

#: include/arrays.php
msgid "Settings"
msgstr "Ntọala"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Zoo mkpado na eserese"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ọ bụrụ na ahọrọ ya, ngwa mgbakwunye agaghị egosi mkpado na eserese"

#: include/arrays.php
msgid "Data Retention"
msgstr "Nchekwa Data"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Mgbe oge a gasịrị, a ga-ebufe mkpado n'ebe nchekwa ma agaghị egosikwa ha ọzọ"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Oke nkọwa eserese"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ọ bụrụ na ọnụọgụ mkpado karịrị oke, a ga-achịkọta nkọwa eserese. N'ihi nsogbu ngosi nwere ike ibilite, ọnụọgụ ahịrị kwụ ọtọ nwere oke ruo okpukpu 5 nke ọnụ ahịa a."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Họrọ Ngwaọrụ Isi"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Ọ na-abụkarị ngwaọrụ Cacti mpaghara. A ga-egosi mkpado metụtara usoro Cacti ebe a."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Mkpado akpaghị aka - maka host kpọmkwem"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Mkpado akpaghị aka maka mmalitegharị host"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ọ bụrụ na ahọrọ ya, ngwa mgbakwunye ga-emepụta mkpado akpaghị aka mgbe ngwaọrụ malitegharịrị"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Agba mkpado mmalitegharị host"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Ndụmọdụ: Jiri agba dị iche maka mkpado akpaghị aka ọ bụla"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Mkpado akpaghị aka mgbe agbakwunyere host. A ga-egosi ya na ngwaọrụ 'Nke Ndabere' na ngwaọrụ kpọmkwem"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ọ bụrụ na ahọrọ ya, ngwa mgbakwunye ga-emepụta mkpado akpaghị aka mgbe agbakwunyere ngwaọrụ"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Agba mkpado agbakwunyere host"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Mkpado akpaghị aka maka nchekwa/mgbanwe ngwaọrụ"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ọ bụrụ na ahọrọ ya, ngwa mgbakwunye ga-emepụta mkpado akpaghị aka mgbe echekwara (gbanwere) ngwaọrụ"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Agba mkpado nchekwa/mgbanwe ngwaọrụ"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Mkpado akpaghị aka maka ndezigharị ndepụta isi iyi data"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Mepụta mkpado mgbe ndepụta nke ajụjụ data ngwaọrụ weghachiri gbanwere."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Agba mkpado ndezigharị ndepụta isi iyi data"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Mkpado akpaghị aka - ndị ọzọ"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Họrọ otu a ga-esi gosi mkpado edepụtara n'okpuru"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Maka ngwaọrụ ndị dị aṅaa ka a ga-egosi mkpado ndị dị n'okpuru?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Mkpado akpaghị aka maka ụdị Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ọ bụrụ na ahọrọ ya, ngwa mgbakwunye ga-emepụta mkpado akpaghị aka mgbe agbanwere ụdị Cacti. Mkpado bụ maka eserese niile."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Agba mkpado ụdị Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Mkpado akpaghị aka maka nfefe oge poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Mepụta mkpado mgbe usoro nyocha nke ngwa nchịkọta data karịrị oge poller ahaziri."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Agba mkpado nfefe oge poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Mkpado akpaghị aka maka ọnọdụ ngwa nchịkọta data"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Mepụta mkpado mgbe ngwa nchịkọta data dị anya kwụsịrị ịrụ ọrụ ma ọ bụ laghachi n'ọrụ."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Agba mkpado ọnọdụ ngwa nchịkọta data"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Mkpado akpaghị aka maka ọnọdụ ngwa mgbakwunye"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Mepụta mkpado mgbe ọnọdụ ngwa mgbakwunye ọ bụla gbanwere (gbanye/gbanyụọ/kwalite)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Agba mkpado ọnọdụ ngwa mgbakwunye"

