msgid "If checked, plugin will not display tags in graphs"
msgstr "Ja atzīmēts, spraudnis nerādīs birkas grafikos"

#: include/arrays.php
msgid "Data Retention"
msgstr "Datu saglabāšana"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Pēc šī laika birkas tiks pārvietotas uz arhīvu un vairs netiks rādītas"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Grafika leģendas ierobežojums"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ja birku skaits pārsniedz ierobežojumu, leģenda tiks apkopota. Iespējamo attēlošanas problēmu dēļ vertikālo līniju skaits ir ierobežots līdz 5 reizēm šīs vērtības."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Atlasīt primāro ierīci"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Parasti vietējā Cacti ierīce. Šeit tiks rādītas ar Cacti sistēmu saistītās birkas."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automātiskās birkas - konkrētam resursdatoram"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Resursdatora restartēšanas automātiskā birka"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ja atzīmēts, spraudnis izveidos automātisku birku, kad ierīce tiks restartēta"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Resursdatora restartēšanas birkas krāsa"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Ieteikums: katrai automātiskajai birkai izmantojiet citu krāsu"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Resursdatora pievienošanas automātiskā birka. Tiks rādīta 'Noklusējuma' ierīcē un konkrētajā ierīcē"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ja atzīmēts, spraudnis izveidos automātiskas birkas, kad tiks pievienota ierīce"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Resursdatora pievienošanas birkas krāsa"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Ierīces saglabāšanas/maiņas automātiskā birka"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ja atzīmēts, spraudnis izveidos automātisku birku, kad ierīce tiks saglabāta (mainīta)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Ierīces saglabāšanas/maiņas birkas krāsa"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Datu avota pārindeksēšanas automātiskā birka"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Izveidot birku, kad mainās ierīces datu vaicājuma atgrieztā indeksu kopa."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Datu avota pārindeksēšanas birkas krāsa"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automātiskās birkas - citas"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Izvēlieties, kā rādīt tālāk norādītās birkas"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Kurām ierīcēm tiks rādītas tālāk norādītās birkas?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Cacti versijas automātiskā birka"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ja atzīmēts, spraudnis izveidos automātisku birku, kad mainīsies Cacti versija. Birka attiecas uz visiem grafikiem."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Cacti versijas birkas krāsa"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Aptaujātāja pārsnieguma automātiskā birka"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Izveidot birku, kad datu vācēja aptaujas cikls pārsniedz konfigurēto aptaujātāja intervālu."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Aptaujātāja pārsnieguma birkas krāsa"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Datu vācēja statusa automātiskās birkas"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Izveidot birkas, kad attālais datu vācējs pārstāj darboties vai tiek atjaunots."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Datu vācēja statusa birkas krāsa"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Spraudņa statusa automātiskā birka"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Izveidot birku, kad mainās jebkura spraudņa statuss (iespējošana/atspējošana/jaunināšana)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Spraudņa stāvokļa birkas krāsa"

