msgstr "Toerana"

#: include/arrays.php
msgid "Select site"
msgstr "Misafidiana toerana"

#: include/arrays.php
msgid "Date and time of tag"
msgstr "Daty sy oran'ny marika"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Ny daty / ora ho an'ity marika ity."

#: include/arrays.php
msgid "Choose color"
msgstr "Misafidiana loko"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Misafidiana loko ho an'ity marika ity"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Alefa"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Ny marika najanona dia tsy hiseho eo amin'ny kisary."

#: include/arrays.php
msgid "Settings"
msgstr "Fikirana"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Afeno ny marika eo amin'ny kisary"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Raha voamarika, ny plugin dia tsy hampiseho marika eo amin'ny kisary"

#: include/arrays.php
msgid "Data Retention"
msgstr "Fitahirizana angona"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Rehefa tapitra io fotoana io, dia hafindra any amin'ny arisiva ny marika ary tsy hiseho intsony"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Fetran'ny fanazavana eo amin'ny kisary"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Raha mihoatra ny fetra ny isan'ny marika dia hatambatra ny fanazavana. Noho ny mety ho olana eo amin'ny fampisehoana, ny isan'ny tsipika mitsangana dia ferana ho avo 5 heny amin'io sanda io."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Misafidiana Fitaovana Fototra"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Matetika fitaovana Cacti eo an-toerana. Ny marika mifandraika amin'ny rafitra Cacti dia hiseho eto."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Marika mandeha ho azy - manokana ho an'ny mpampiantrano"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Marika mandeha ho azy amin'ny famerenana mamelona mpampiantrano"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Raha voamarika, ny plugin dia hamorona marika mandeha ho azy rehefa miverina velona ny fitaovana"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Lokon'ny marika famerenana mamelona mpampiantrano"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Torohevitra: Mampiasà loko samihafa ho an'ny marika mandeha ho azy tsirairay"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Marika mandeha ho azy amin'ny fanampiana mpampiantrano. Hiseho eo amin'ny fitaovana 'Voafaritra mialoha' sy ilay fitaovana manokana"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Raha voamarika, ny plugin dia hamorona marika mandeha ho azy rehefa misy fitaovana ampiana"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Lokon'ny marika fanampiana mpampiantrano"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Marika mandeha ho azy amin'ny fitahirizana/fanovana fitaovana"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Raha voamarika, ny plugin dia hamorona marika mandeha ho azy rehefa tahirizina (ovaina) ny fitaovana"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Lokon'ny marika fitahirizana/fanovana fitaovana"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Marika mandeha ho azy amin'ny fanavaozana fanondroan'ny loharanon'angona"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Mamorona marika rehefa miova ny lisitry ny fanondroana averin'ny fangatahana angon'ny fitaovana."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Lokon'ny marika fanavaozana fanondroan'ny loharanon'angona"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Marika mandeha ho azy - hafa"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Safidio ny fomba fampisehoana ireo marika voatanisa eto ambany"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Ho an'ny fitaovana iza avy no hampisehoana ireo marika eto ambany?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Marika mandeha ho azy amin'ny kinovan'ny Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Raha voamarika, ny plugin dia hamorona marika mandeha ho azy rehefa miova ny kinovan'ny Cacti. Ho an'ny kisary rehetra ny marika."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Lokon'ny marika kinovan'ny Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Marika mandeha ho azy amin'ny fiotazan'ny fotoana fanadihadiana"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Mamorona marika rehefa mihoatra ny elanelam-potoana napetraka ny tsingerin'ny fanadihadian'ny mpanangona angona."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Lokon'ny marika fiotazan'ny fotoana fanadihadiana"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Marika mandeha ho azy momba ny satan'ny mpanangona angona"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Mamorona marika rehefa tsy mandeha na miverina mandeha ny mpanangona angona lavitra."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Lokon'ny marika satan'ny mpanangona angona"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Marika mandeha ho azy momba ny satan'ny plugin"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Mamorona marika rehefa miova ny satan'ny plugin iray (alefa/ajanona/fanavaozana)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Lokon'ny marika toetry ny plugin"

