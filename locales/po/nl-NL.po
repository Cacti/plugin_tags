msgid "Select color for this tag"
msgstr "Selecteer een kleur voor deze tag"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Inschakelen"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Een uitgeschakelde tag wordt niet weergegeven in de grafiek."

#: include/arrays.php
msgid "Settings"
msgstr "Instellingen"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Tags verbergen in grafieken"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Indien aangevinkt toont de plug-in geen tags in grafieken"

#: include/arrays.php
msgid "Data Retention"
msgstr "Dataretentie"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Na deze tijd worden tags verplaatst naar het archief en niet meer weergegeven"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Limiet grafieklegenda"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Als het aantal tags groter is dan de limiet, wordt de legenda samengevoegd. Vanwege mogelijke weergaveproblemen is het aantal verticale lijnen beperkt tot 5 keer deze waarde."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Selecteer primair apparaat"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Meestal een lokaal Cacti-apparaat. Tags met betrekking tot het Cacti-systeem worden hier weergegeven."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automatische tags - hostspecifiek"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatische tag bij herstart host"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Indien aangevinkt maakt de plug-in automatisch een tag aan wanneer een apparaat herstart"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Kleur van tag bij herstart host"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Aanbeveling: gebruik een andere kleur voor elke automatische tag"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatische tag bij toevoegen host. Wordt weergegeven op het apparaat 'Standaard' en het specifieke apparaat"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Indien aangevinkt maakt de plug-in automatisch tags aan wanneer een apparaat wordt toegevoegd"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Kleur van tag bij toevoegen host"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatische tag bij opslaan/wijzigen apparaat"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Indien aangevinkt maakt de plug-in automatisch een tag aan wanneer een apparaat wordt opgeslagen (gewijzigd)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Kleur van tag bij opslaan/wijzigen apparaat"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatische tag bij herindexeren gegevensbron"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Maak een tag aan wanneer de reeks indexen die door een gegevensquery van een apparaat wordt geretourneerd wijzigt."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Kleur van tag bij herindexeren gegevensbron"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automatische tags - overige"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Kies hoe de onderstaande tags worden weergegeven"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Voor welke apparaten worden de onderstaande tags weergegeven?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatische tag voor Cacti-versie"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Indien aangevinkt maakt de plug-in automatisch een tag aan wanneer de Cacti-versie wordt gewijzigd. De tag geldt voor alle grafieken."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Kleur van tag voor Cacti-versie"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatische tag bij poller-overschrijding"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Maak een tag aan wanneer een pollingcyclus van een gegevensverzamelaar het geconfigureerde pollerinterval overschrijdt."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Kleur van tag bij poller-overschrijding"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatische tags voor status gegevensverzamelaar"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Maak tags aan wanneer een externe gegevensverzamelaar uitvalt of herstelt."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Kleur van tag voor status gegevensverzamelaar"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatische tag voor plug-instatus"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Maak een tag aan wanneer de status van een plug-in wijzigt (inschakelen/uitschakelen/bijwerken)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Kleur van tag voor plug-instatus"

