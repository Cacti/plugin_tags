msgid "Settings"
msgstr "Ustawienia"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ukryj tagi na wykresach"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Jeśli zaznaczone, wtyczka nie będzie wyświetlać tagów na wykresach"

#: include/arrays.php
msgid "Data Retention"
msgstr "Przechowywanie danych"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Po tym czasie tagi zostaną przeniesione do archiwum i nie będą już wyświetlane"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Limit legendy wykresu"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Jeśli liczba tagów przekroczy limit, legenda zostanie zagregowana. Ze względu na możliwe problemy z wyświetlaniem liczba linii pionowych jest ograniczona do 5-krotności tej wartości."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Wybierz urządzenie główne"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Zwykle lokalne urządzenie Cacti. Tutaj będą wyświetlane tagi związane z systemem Cacti."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Tagi automatyczne - specyficzne dla hosta"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatyczny tag restartu hosta"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Jeśli zaznaczone, wtyczka utworzy automatyczny tag po restarcie urządzenia"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Kolor tagu restartu hosta"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Zalecenie: użyj innego koloru dla każdego tagu automatycznego"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatyczny tag dodania hosta. Zostanie wyświetlony na urządzeniu 'Domyślny' oraz na konkretnym urządzeniu"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Jeśli zaznaczone, wtyczka utworzy automatyczne tagi po dodaniu urządzenia"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Kolor tagu dodania hosta"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatyczny tag zapisu/zmiany urządzenia"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Jeśli zaznaczone, wtyczka utworzy automatyczny tag po zapisaniu (zmianie) urządzenia"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Kolor tagu zapisu/zmiany urządzenia"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatyczny tag ponownego indeksowania źródła danych"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Utwórz tag, gdy zmieni się zestaw indeksów zwracany przez zapytanie danych urządzenia."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Kolor tagu ponownego indeksowania źródła danych"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Tagi automatyczne - inne"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Wybierz sposób wyświetlania tagów wymienionych poniżej"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Dla których urządzeń mają być wyświetlane poniższe tagi?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatyczny tag wersji Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Jeśli zaznaczone, wtyczka utworzy automatyczny tag po zmianie wersji Cacti. Tag dotyczy wszystkich wykresów."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Kolor tagu wersji Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatyczny tag przekroczenia czasu pollera"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Utwórz tag, gdy cykl odpytywania kolektora danych przekroczy skonfigurowany interwał pollera."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Kolor tagu przekroczenia czasu pollera"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatyczne tagi stanu kolektora danych"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Twórz tagi, gdy zdalny kolektor danych przestanie działać lub odzyska sprawność."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Kolor tagu stanu kolektora danych"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatyczny tag stanu wtyczki"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Utwórz tag, gdy zmieni się stan dowolnej wtyczki (włączenie/wyłączenie/aktualizacja)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Kolor tagu stanu wtyczki"

