#: include/arrays.php tags.php
msgid "Enable"
msgstr "Habilitar"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "A tag desabilitada não será exibida no gráfico."

#: include/arrays.php
msgid "Settings"
msgstr "Configurações"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ocultar tags nos gráficos"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Se marcado, o plugin não exibirá tags nos gráficos"

#: include/arrays.php
msgid "Data Retention"
msgstr "Retenção de Dados"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Após esse período, as tags serão movidas para o arquivo e não serão mais exibidas"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Limite da legenda do gráfico"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Se o número de tags for maior que o limite, a legenda será agregada. Devido a possíveis problemas de exibição, o número de linhas verticais é limitado a 5 vezes este valor."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Selecionar dispositivo principal"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Normalmente um dispositivo Cacti local. As tags relacionadas ao sistema Cacti serão exibidas aqui."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Tags automáticas - específicas do host"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Tag automática de reinicialização do host"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Se marcado, o plugin criará uma tag automática quando o dispositivo reiniciar"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Cor da tag de reinicialização do host"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Recomendação: use uma cor diferente para cada tag automática"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Tag automática de adição de host. Será exibida no dispositivo 'Padrão' e no dispositivo específico"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Se marcado, o plugin criará tags automáticas quando um dispositivo for adicionado"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Cor da tag de adição de host"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Tag automática de salvamento/alteração de dispositivo"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Se marcado, o plugin criará uma tag automática quando o dispositivo for salvo (alterado)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Cor da tag de salvamento/alteração de dispositivo"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Tag automática de reindexação de fonte de dados"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Cria uma tag quando o conjunto de índices retornado por uma consulta de dados de dispositivo muda."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Cor da tag de reindexação de fonte de dados"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Tags automáticas - outras"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Escolha como exibir as tags listadas abaixo"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Para quais dispositivos as tags abaixo serão exibidas?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Tag automática de versão do Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Se marcado, o plugin criará uma tag automática quando a versão do Cacti for alterada. A tag é para todos os gráficos."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Cor da tag de versão do Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Tag automática de excesso de tempo do poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Cria uma tag quando um ciclo de coleta de um coletor de dados excede o intervalo configurado do poller."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Cor da tag de excesso de tempo do poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Tags automáticas de status do coletor de dados"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Cria tags quando um coletor de dados remoto fica inativo ou se recupera."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Cor da tag de status do coletor de dados"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Tag automática de status de plugin"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Cria uma tag quando o status de qualquer plugin muda (habilitar/desabilitar/atualizar)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Cor da tag de estado do plugin"

