msgstr "Выберите цвет для этого тега"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Включить"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Отключённый тег не будет отображаться на графике."

#: include/arrays.php
msgid "Settings"
msgstr "Настройки"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Скрывать теги на графиках"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Если отмечено, плагин не будет отображать теги на графиках"

#: include/arrays.php
msgid "Data Retention"
msgstr "Хранение данных"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "По истечении этого времени теги будут перемещены в архив и перестанут отображаться"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Лимит легенды графика"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Если количество тегов превышает лимит, легенда будет сгруппирована. Из-за возможных проблем с отображением количество вертикальных линий ограничено пятикратным значением этого лимита."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Выберите основное устройство"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Обычно это локальное устройство Cacti. Здесь будут отображаться теги, связанные с системой Cacti."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Автоматические теги - для хостов"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Автоматический тег перезагрузки хоста"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Если отмечено, плагин будет автоматически создавать тег при перезагрузке устройства"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Цвет тега перезагрузки хоста"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Рекомендация: используйте отдельный цвет для каждого автоматического тега"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Автоматический тег добавления хоста. Будет отображаться на устройстве «Стандартно» и на конкретном устройстве"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Если отмечено, плагин будет автоматически создавать теги при добавлении устройства"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Цвет тега добавления хоста"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Автоматический тег сохранения/изменения устройства"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Если отмечено, плагин будет автоматически создавать тег при сохранении (изменении) устройства"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Цвет тега сохранения/изменения устройства"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Автоматический тег переиндексации источника данных"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Создавать тег при изменении набора индексов, возвращаемых запросом данных устройства."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Цвет тега переиндексации источника данных"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Автоматические теги - прочие"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Выберите способ отображения перечисленных ниже тегов"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Для каких устройств будут отображаться указанные ниже теги?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Автоматический тег версии Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Если отмечено, плагин будет автоматически создавать тег при изменении версии Cacti. Тег применяется ко всем графикам."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Цвет тега версии Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Автоматический тег превышения времени поллера"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Создавать тег, когда цикл опроса сборщика данных превышает настроенный интервал поллера."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Цвет тега превышения времени поллера"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Автоматические теги состояния сборщика данных"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Создавать теги, когда удалённый сборщик данных выходит из строя или восстанавливается."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Цвет тега состояния сборщика данных"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Автоматический тег состояния плагина"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Создавать тег при изменении состояния любого плагина (включение/отключение/обновление)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Цвет тега состояния плагина"

