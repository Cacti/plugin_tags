#: include/arrays.php
msgid "Date and time of tag"
msgstr "Itariki n'isaha by'ikirango"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Itariki / isaha y'iki kirango."

#: include/arrays.php
msgid "Choose color"
msgstr "Hitamo ibara"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Hitamo ibara ry'iki kirango"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Koresha"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Ikirango cyahagaritswe ntikizagaragara ku gishushanyo."

#: include/arrays.php
msgid "Settings"
msgstr "Igenamiterere"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Hisha ibirango ku bishushanyo"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Nibiba byemejwe, umugereka ntuzerekana ibirango ku bishushanyo"

#: include/arrays.php
msgid "Data Retention"
msgstr "Igihe cyo Kubika Amakuru"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Nyuma y'iki gihe, ibirango bizajyanwa mu bubiko kandi ntibizongera kugaragara"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Umubare ntarengwa w'ibisobanuro by'igishushanyo"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Niba umubare w'ibirango urenze umubare ntarengwa, ibisobanuro bizahurizwa hamwe. Kubera ibibazo bishobora kubaho mu kugaragaza, umubare w'imirongo ihagaze ugarukira ku nshuro 5 z'uyu mubare."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Hitamo Igikoresho cy'Ibanze"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Ubusanzwe ni igikoresho cya Cacti cyo hafi. Ibirango bijyanye na sisitemu ya Cacti bizagaragara hano."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Ibirango byikora - byihariye kuri mudasobwa"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Ikirango cyikora cyo kongera gutangiza igikoresho"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Nibiba byemejwe, umugereka uzakora ikirango cyikora igihe igikoresho cyongeye gutangira"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Ibara ry'ikirango cyo kongera gutangiza igikoresho"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Inama: Koresha ibara ritandukanye kuri buri kirango cyikora"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Ikirango cyikora cyo kongeraho igikoresho. Kizagaragara ku gikoresho cya 'Mburabuzi' no ku gikoresho cyihariye"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Nibiba byemejwe, umugereka uzakora ibirango byikora igihe igikoresho cyongeweho"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Ibara ry'ikirango cyo kongeraho igikoresho"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Ikirango cyikora cyo kubika/guhindura igikoresho"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Nibiba byemejwe, umugereka uzakora ikirango cyikora igihe igikoresho kibitswe (gihinduwe)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Ibara ry'ikirango cyo kubika/guhindura igikoresho"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Ikirango cyikora cyo kongera gutondeka isoko y'amakuru"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Kora ikirango igihe urutonde rw'ibipimo rugarurwa n'ishakisha ry'amakuru y'igikoresho ruhindutse."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Ibara ry'ikirango cyo kongera gutondeka isoko y'amakuru"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Ibirango byikora - ibindi"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Hitamo uburyo bwo kugaragaza ibirango biri hasi"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Ni ku bihe bikoresho ibirango biri hasi bizagaragara?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Ikirango cyikora cya verisiyo ya Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Nibiba byemejwe, umugereka uzakora ikirango cyikora igihe verisiyo ya Cacti ihinduwe. Ibirango bireba ibishushanyo byose."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Ibara ry'ikirango cya verisiyo ya Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Ikirango cyikora cyo kurenga igihe cya poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Kora ikirango igihe ikusanya ry'amakuru rirenze igihe cyagenwe cya poller."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Ibara ry'ikirango cyo kurenga igihe cya poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Ibirango byikora by'imiterere y'ikusanyamakuru"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Kora ibirango igihe ikusanyamakuru rya kure rihagaze cyangwa ryongeye gukora."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Ibara ry'ikirango cy'imiterere y'ikusanyamakuru"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Ikirango cyikora cy'imiterere y'umugereka"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Kora ikirango igihe imiterere y'umugereka uwo ari wo wose ihindutse (gukoresha/guhagarika/kuvugurura)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Ibara ry'ikirango cy'imiterere y'umugereka"

