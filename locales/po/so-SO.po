msgid "Select color for this tag"
msgstr "Dooro midabka calaamaddan"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Hawl-geli"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Calaamadda la hawl-joojiyay laguma muujin doono garaafka."

#: include/arrays.php
msgid "Settings"
msgstr "Dejinta"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ku qari calaamadaha garaafyada"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Haddii la calaamadeeyo, plugin-ku kuma muujin doono calaamadaha garaafyada"

#: include/arrays.php
msgid "Data Retention"
msgstr "Haynta Xogta"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Waqtigan ka dib, calaamadaha waxaa loo rari doonaa kaydka mana la muujin doono mar dambe"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Xadka furaha garaafka"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Haddii tirada calaamaduhu ka weyn tahay xadka, furaha waa la isku dari doonaa. Sababo la xiriira arrimo muujin oo suurtagal ah, tirada xariiqyada toosan waxay ku xaddidan tahay 5 jeer qiimahan."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Dooro Qalabka Aasaasiga ah"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Caadi ahaan waa qalab Cacti oo maxalli ah. Calaamadaha la xiriira nidaamka Cacti waxaa lagu muujin doonaa halkan."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Calaamadaha otomaatiga ah - gaar u ah martigeliyaha"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Calaamadda otomaatiga ah ee dib-u-bilowga martigeliyaha"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Haddii la calaamadeeyo, plugin-ku wuxuu abuurayaa calaamad otomaatig ah marka qalabku dib u bilowdo"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Midabka calaamadda dib-u-bilowga martigeliyaha"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Talo: U adeegso midab ka duwan calaamad kasta oo otomaatig ah"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Calaamadda otomaatiga ah ee martigeliyaha la daray. Waxaa lagu muujin doonaa qalabka 'Asal ah' iyo qalabka gaarka ah"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Haddii la calaamadeeyo, plugin-ku wuxuu abuurayaa calaamado otomaatig ah marka qalab lagu daro"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Midabka calaamadda martigeliyaha la daray"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Calaamadda otomaatiga ah ee kaydinta/beddelka qalabka"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Haddii la calaamadeeyo, plugin-ku wuxuu abuurayaa calaamad otomaatig ah marka qalabka la kaydiyo (la beddelo)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Midabka calaamadda kaydinta/beddelka qalabka"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Calaamadda otomaatiga ah ee dib-u-tixraaca isha xogta"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Abuur calaamad marka xirmada tixraacyada ee uu soo celiyo weydiinta xogta qalabku isbeddesho."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Midabka calaamadda dib-u-tixraaca isha xogta"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Calaamadaha otomaatiga ah - kuwa kale"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Dooro sida loo muujinayo calaamadaha hoos ku taxan"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Qalabyadee ayaa lagu muujin doonaa calaamadaha hoose?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Calaamadda otomaatiga ah ee nooca Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Haddii la calaamadeeyo, plugin-ku wuxuu abuurayaa calaamad otomaatig ah marka nooca Cacti la beddelo. Calaamaduhu waxay khuseeyaan dhammaan garaafyada."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Midabka calaamadda nooca Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Calaamadda otomaatiga ah ee xad-dhaafka poller-ka"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Abuur calaamad marka wareegga xog-qaadista xog-ururiyuhu dhaafo muddada loo dejiyay poller-ka."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Midabka calaamadda xad-dhaafka poller-ka"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Calaamadaha otomaatiga ah ee xaaladda xog-ururiyaha"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Abuur calaamado marka xog-ururiye fog uu go'o ama soo kabto."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Midabka calaamadda xaaladda xog-ururiyaha"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Calaamadda otomaatiga ah ee xaaladda plugin-ka"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Abuur calaamad marka xaaladda plugin kasta isbeddesho (hawl-geli/hawl-jooji/casriyee)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Midabka calaamadda xaaladda plugin-ka"

