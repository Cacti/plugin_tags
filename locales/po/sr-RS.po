msgid "If checked, plugin will not display tags in graphs"
msgstr "Ако је означено, додатак неће приказивати ознаке на графиконима"

#: include/arrays.php
msgid "Data Retention"
msgstr "Задржавање података"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Након овог времена ознаке ће бити премештене у архиву и више неће бити приказане"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Ограничење легенде графикона"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ако је број ознака већи од ограничења, легенда ће бити обједињена. Због могућих проблема са приказом, број вертикалних линија је ограничен на 5 пута ову вредност."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Изаберите примарни уређај"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Обично локални Cacti уређај. Овде ће бити приказане ознаке везане за систем Cacti."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Аутоматске ознаке - специфичне за хост"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Аутоматска ознака поновног покретања хоста"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ако је означено, додатак ће аутоматски креирати ознаку када се уређај поново покрене"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Боја ознаке поновног покретања хоста"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Препорука: Користите другу боју за сваку аутоматску ознаку"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Аутоматска ознака додавања хоста. Биће приказана на уређају 'Подразумевано' и на конкретном уређају"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ако је означено, додатак ће аутоматски креирати ознаке када се дода уређај"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Боја ознаке додавања хоста"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Аутоматска ознака чувања/измене уређаја"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ако је означено, додатак ће аутоматски креирати ознаку када се уређај сачува (измени)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Боја ознаке чувања/измене уређаја"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Аутоматска ознака поновног индексирања извора података"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Креирај ознаку када се промени скуп индекса који враћа упит података уређаја."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Боја ознаке поновног индексирања извора података"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Аутоматске ознаке - остале"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Изаберите како ће се приказивати доленаведене ознаке"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "За које уређаје ће бити приказане доленаведене ознаке?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Аутоматска ознака верзије Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ако је означено, додатак ће аутоматски креирати ознаку када се промени верзија Cacti. Ознаке важе за све графиконе."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Боја ознаке верзије Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Аутоматска ознака прекорачења времена полера"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Креирај ознаку када циклус прикупљања података премаши конфигурисани интервал полера."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Боја ознаке прекорачења времена полера"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Аутоматске ознаке статуса прикупљача података"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Креирај ознаке када удаљени прикупљач података постане недоступан или се опорави."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Боја ознаке статуса прикупљача података"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Аутоматска ознака статуса додатка"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Креирај ознаку када се промени статус било ког додатка (омогући/онемогући/надогради)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Боја ознаке стања додатка"

