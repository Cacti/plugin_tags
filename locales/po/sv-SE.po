msgid "Select color for this tag"
msgstr "Välj färg för denna tagg"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Aktivera"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Inaktiverad tagg visas inte i grafen."

#: include/arrays.php
msgid "Settings"
msgstr "Inställningar"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Dölj taggar i grafer"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Om markerad visar insticksprogrammet inte taggar i grafer"

#: include/arrays.php
msgid "Data Retention"
msgstr "Lagringstid"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Efter denna tid flyttas taggar till arkivet och visas inte längre"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Gräns för grafförklaring"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Om antalet taggar överstiger gränsen slås förklaringen samman. På grund av eventuella visningsproblem begränsas antalet vertikala linjer till 5 gånger detta värde."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Välj primär enhet"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Vanligtvis en lokal Cacti-enhet. Taggar relaterade till Cacti-systemet visas här."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Automatiska taggar - värdspecifika"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Automatisk tagg för värdomstart"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Om markerad skapar insticksprogrammet en automatisk tagg när enheten startas om"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Färg på tagg för värdomstart"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Rekommendation: Använd olika färger för varje automatisk tagg"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Automatisk tagg för tillagd värd. Visas på 'Standard'-enheten och den specifika enheten"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Om markerad skapar insticksprogrammet automatiska taggar när en enhet läggs till"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Färg på tagg för tillagd värd"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Automatisk tagg för sparad/ändrad enhet"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Om markerad skapar insticksprogrammet en automatisk tagg när enheten sparas (ändras)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Färg på tagg för sparad/ändrad enhet"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Automatisk tagg för omindexering av datakälla"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Skapa en tagg när uppsättningen index som returneras av en enhets datafråga ändras."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Färg på tagg för omindexering av datakälla"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Automatiska taggar - övriga"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Välj hur taggarna nedan ska visas"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "För vilka enheter ska taggarna nedan visas?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Automatisk tagg för Cacti-version"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Om markerad skapar insticksprogrammet en automatisk tagg när Cacti-versionen ändras. Taggen gäller alla grafer."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Färg på tagg för Cacti-version"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Automatisk tagg för polleröverskridning"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Skapa en tagg när en datainsamlares pollercykel överskrider det konfigurerade pollerintervallet."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Färg på tagg för polleröverskridning"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Automatiska taggar för datainsamlarstatus"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Skapa taggar när en fjärrdatainsamlare går ner eller återhämtar sig."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Färg på tagg för datainsamlarstatus"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Automatisk tagg för insticksprogramsstatus"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Skapa en tagg när något insticksprograms status ändras (aktivera/inaktivera/uppgradera)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Färg på tagg för insticksprogramstillstånd"

