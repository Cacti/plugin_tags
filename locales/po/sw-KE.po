#: include/arrays.php tags.php
msgid "Enable"
msgstr "Wezesha"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Lebo iliyolemazwa haitaonyeshwa kwenye grafu."

#: include/arrays.php
msgid "Settings"
msgstr "Mipangilio"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ficha lebo kwenye grafu"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ikichaguliwa, programu-jalizi haitaonyesha lebo kwenye grafu"

#: include/arrays.php
msgid "Data Retention"
msgstr "Uhifadhi wa Data"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Baada ya muda huu, lebo zitahamishiwa kwenye kumbukumbu na hazitaonyeshwa tena"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Kikomo cha ufunguo wa grafu"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ikiwa idadi ya lebo ni kubwa kuliko kikomo, ufunguo utajumuishwa pamoja. Kutokana na uwezekano wa matatizo ya uonyeshaji, idadi ya mistari ya wima imezuiliwa kuwa mara 5 ya thamani hii."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Chagua Kifaa Kikuu"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Kwa kawaida ni kifaa cha ndani cha Cacti. Lebo zinazohusiana na mfumo wa Cacti zitaonyeshwa hapa."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Lebo za otomatiki - mahususi kwa kifaa"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Lebo ya otomatiki ya kuwasha upya kifaa"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ikichaguliwa, programu-jalizi itaunda lebo ya otomatiki kifaa kinapowashwa upya"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Rangi ya lebo ya kuwasha upya kifaa"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Pendekezo: Tumia rangi tofauti kwa kila lebo ya otomatiki"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Lebo ya otomatiki ya kifaa kilichoongezwa. Itaonyeshwa kwenye kifaa cha 'Chaguo-msingi' na kifaa mahususi"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ikichaguliwa, programu-jalizi itaunda lebo za otomatiki kifaa kinapoongezwa"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Rangi ya lebo ya kifaa kilichoongezwa"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Lebo ya otomatiki ya kuhifadhi/kubadilisha kifaa"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ikichaguliwa, programu-jalizi itaunda lebo ya otomatiki kifaa kinapohifadhiwa (kubadilishwa)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Rangi ya lebo ya kuhifadhi/kubadilisha kifaa"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Lebo ya otomatiki ya kufanyia fahirisi upya chanzo cha data"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Unda lebo wakati orodha ya fahirisi inayorejeshwa na hoja ya data ya kifaa inapobadilika."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Rangi ya lebo ya kufanyia fahirisi upya chanzo cha data"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Lebo za otomatiki - nyingine"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Chagua jinsi ya kuonyesha lebo zilizoorodheshwa hapa chini"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Ni kwa vifaa vipi lebo zilizo hapa chini zitaonyeshwa?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Lebo ya otomatiki ya toleo la Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ikichaguliwa, programu-jalizi itaunda lebo ya otomatiki toleo la Cacti linapobadilishwa. Lebo ni za grafu zote."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Rangi ya lebo ya toleo la Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Lebo ya otomatiki ya kupitiliza muda wa poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Unda lebo wakati mzunguko wa ukusanyaji wa kikusanya data unapozidi muda wa poller uliosanidiwa."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Rangi ya lebo ya kupitiliza muda wa poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Lebo za otomatiki za hali ya kikusanya data"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Unda lebo wakati kikusanya data cha mbali kinapokatika au kurejea."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Rangi ya lebo ya hali ya kikusanya data"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Lebo ya otomatiki ya hali ya programu-jalizi"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Unda lebo wakati hali ya programu-jalizi yoyote inapobadilika (wezesha/lemaza/pandisha toleo)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Rangi ya lebo ya hali ya programu-jalizi"

