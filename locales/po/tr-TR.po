msgid "Disabled tag will not be shown in graph."
msgstr "Devre dışı bırakılan etiket grafikte gösterilmeyecektir."

#: include/arrays.php
msgid "Settings"
msgstr "Ayarlar"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Etiketleri grafiklerde gizle"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "İşaretlenirse, eklenti etiketleri grafiklerde göstermez"

#: include/arrays.php
msgid "Data Retention"
msgstr "Verilerin Saklanması"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Bu süreden sonra etiketler arşive taşınır ve artık gösterilmez"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Grafik açıklama sınırı"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Etiket sayısı sınırdan büyükse açıklama birleştirilir. Olası görüntüleme sorunları nedeniyle dikey çizgi sayısı bu değerin 5 katı ile sınırlıdır."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Birincil Cihazı Seçin"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Genellikle yerel bir Cacti cihazıdır. Cacti sistemiyle ilgili etiketler burada gösterilir."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Otomatik etiketler - ana bilgisayara özel"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Ana bilgisayar yeniden başlatma otomatik etiketi"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "İşaretlenirse, cihaz yeniden başlatıldığında eklenti otomatik etiket oluşturur"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Ana bilgisayar yeniden başlatma etiketi rengi"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Öneri: Her otomatik etiket için farklı bir renk kullanın"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Ana bilgisayar eklendi otomatik etiketi. 'Varsayılan' cihazda ve ilgili cihazda gösterilir"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "İşaretlenirse, cihaz eklendiğinde eklenti otomatik etiketler oluşturur"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Ana bilgisayar eklendi etiketi rengi"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Cihaz kaydetme/değiştirme otomatik etiketi"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "İşaretlenirse, cihaz kaydedildiğinde (değiştirildiğinde) eklenti otomatik etiket oluşturur"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Cihaz kaydetme/değiştirme etiketi rengi"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Veri kaynağı yeniden indeksleme otomatik etiketi"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Bir cihaz veri sorgusunun döndürdüğü indeks kümesi değiştiğinde etiket oluştur."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Veri kaynağı yeniden indeksleme etiketi rengi"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Otomatik etiketler - diğerleri"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Aşağıda listelenen etiketlerin nasıl gösterileceğini seçin"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Aşağıdaki etiketler hangi cihazlar için gösterilsin?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Cacti sürümü otomatik etiketi"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "İşaretlenirse, Cacti sürümü değiştiğinde eklenti otomatik etiket oluşturur. Etiket tüm grafikler içindir."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Cacti sürümü etiketi rengi"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Poller aşımı otomatik etiketi"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Bir veri toplayıcı yoklama döngüsü yapılandırılan poller aralığını aştığında etiket oluştur."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Poller aşımı etiketi rengi"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Veri toplayıcı durumu otomatik etiketleri"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Uzak bir veri toplayıcı çevrimdışı olduğunda veya kurtarıldığında etiket oluştur."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Veri toplayıcı durumu etiketi rengi"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Eklenti durumu otomatik etiketi"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Herhangi bir eklentinin durumu değiştiğinde (etkinleştirme/devre dışı bırakma/yükseltme) etiket oluştur"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Eklenti durumu etiketi rengi"

