msgid "Enable"
msgstr "Bật"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Thẻ bị vô hiệu hóa sẽ không hiển thị trên biểu đồ."

#: include/arrays.php
msgid "Settings"
msgstr "Cài đặt"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Ẩn thẻ trên biểu đồ"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Nếu được chọn, plugin sẽ không hiển thị thẻ trên biểu đồ"

#: include/arrays.php
msgid "Data Retention"
msgstr "Lưu trữ dữ liệu"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Sau khoảng thời gian này, thẻ sẽ được chuyển vào kho lưu trữ và không còn hiển thị nữa"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Giới hạn chú giải biểu đồ"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Nếu số lượng thẻ lớn hơn giới hạn, chú giải sẽ được gộp lại. Do các sự cố hiển thị tiềm ẩn, số đường dọc được giới hạn ở mức gấp 5 lần giá trị này."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Chọn thiết bị chính"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Thường là một thiết bị Cacti cục bộ. Các thẻ liên quan đến hệ thống Cacti sẽ được hiển thị tại đây."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Thẻ tự động - theo máy chủ"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Thẻ tự động khi máy chủ khởi động lại"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Nếu được chọn, plugin sẽ tạo thẻ tự động khi thiết bị khởi động lại"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Màu thẻ khởi động lại máy chủ"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Khuyến nghị: Sử dụng màu khác nhau cho mỗi thẻ tự động"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Thẻ tự động khi thêm máy chủ. Sẽ hiển thị trên thiết bị 'Mặc định' và thiết bị cụ thể"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Nếu được chọn, plugin sẽ tạo thẻ tự động khi thêm thiết bị"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Màu thẻ thêm máy chủ"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Thẻ tự động khi lưu/thay đổi thiết bị"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Nếu được chọn, plugin sẽ tạo thẻ tự động khi thiết bị được lưu (thay đổi)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Màu thẻ lưu/thay đổi thiết bị"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Thẻ tự động khi lập chỉ mục lại nguồn dữ liệu"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Tạo thẻ khi tập chỉ mục do truy vấn dữ liệu thiết bị trả về thay đổi."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Màu thẻ lập chỉ mục lại nguồn dữ liệu"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Thẻ tự động - khác"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Chọn cách hiển thị các thẻ được liệt kê bên dưới"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Các thẻ bên dưới sẽ được hiển thị cho những thiết bị nào?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Thẻ tự động phiên bản Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Nếu được chọn, plugin sẽ tạo thẻ tự động khi phiên bản Cacti thay đổi. Thẻ áp dụng cho tất cả biểu đồ."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Màu thẻ phiên bản Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Thẻ tự động khi vượt quá thời gian thăm dò"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Tạo thẻ khi chu kỳ thăm dò của bộ thu thập dữ liệu vượt quá khoảng thời gian thăm dò đã cấu hình."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Màu thẻ vượt quá thời gian thăm dò"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Thẻ tự động trạng thái bộ thu thập dữ liệu"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Tạo thẻ khi bộ thu thập dữ liệu từ xa ngừng hoạt động hoặc khôi phục."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Màu thẻ trạng thái bộ thu thập dữ liệu"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Thẻ tự động trạng thái plugin"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Tạo thẻ khi trạng thái của bất kỳ plugin nào thay đổi (bật/tắt/nâng cấp)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Màu thẻ trạng thái plugin"

