msgstr "Khetha isiza"

#: include/arrays.php
msgid "Date and time of tag"
msgstr "Umhla nexesha lethegi"

#: include/arrays.php
msgid "The date / time for this tag."
msgstr "Umhla / ixesha lale thegi."

#: include/arrays.php
msgid "Choose color"
msgstr "Khetha umbala"

#: include/arrays.php
msgid "Select color for this tag"
msgstr "Khetha umbala wale thegi"

#: include/arrays.php tags.php
msgid "Enable"
msgstr "Yenza isebenze"

#: include/arrays.php
msgid "Disabled tag will not be shown in graph."
msgstr "Ithegi ekhubaziweyo ayisayi kuboniswa kwigrafu."

#: include/arrays.php
msgid "Settings"
msgstr "Useto"

#: include/arrays.php
msgid "Hide tags in graphs"
msgstr "Fihla iithegi kwiigrafu"

#: include/arrays.php
msgid "If checked, plugin will not display tags in graphs"
msgstr "Ukuba kukhethiwe, iplagini ayisayi kubonisa iithegi kwiigrafu"

#: include/arrays.php
msgid "Data Retention"
msgstr "Ukugcinwa kweDatha"

#: include/arrays.php
msgid "After this time, tags will be moved to the archive and will no longer be displayed"
msgstr "Emva kweli xesha, iithegi ziya kufuduselwa kuvimba kwaye azisayi kuphinda ziboniswe"

#: include/arrays.php
msgid "Graph legend limit"
msgstr "Umda wencazelo yegrafu"

#: include/arrays.php
msgid "If number of tags is bigger than limit, legend will be aggregated. Due to potential display issues, the number of vertical lines is limited to 5 times this value."
msgstr "Ukuba inani leethegi likhulu kunomda, incazelo iya kudityaniswa. Ngenxa yeengxaki ezinokubakho zokubonisa, inani leemigca emileyo lilinganiselwe kumaxesha ama-5 eli xabiso."

#: include/arrays.php
msgid "Select Primary Device"
msgstr "Khetha Isixhobo Esiphambili"

#: include/arrays.php
msgid "Typically a local Cacti device. Tags related to the Cacti system will be displayed here."
msgstr "Ngokuqhelekileyo sisixhobo se-Cacti sasekhaya. Iithegi ezinxulumene nenkqubo ye-Cacti ziya kuboniswa apha."

#: include/arrays.php
msgid "Automatic tags - host specific"
msgstr "Iithegi ezizenzekelayo - ezomamkeli othile"

#: include/arrays.php
msgid "Host restart automatic tag"
msgstr "Ithegi ezenzekelayo yokuqalwa kwakhona komamkeli"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device restarts"
msgstr "Ukuba kukhethiwe, iplagini iya kudala ithegi ezenzekelayo xa isixhobo siqala kwakhona"

#: include/arrays.php
msgid "Host restart tag color"
msgstr "Umbala wethegi wokuqalwa kwakhona komamkeli"

#: include/arrays.php
msgid "Recommendation: Use a different color for each automatic tag"
msgstr "Ingcebiso: Sebenzisa umbala owahlukileyo kwithegi nganye ezenzekelayo"

#: include/arrays.php
msgid "Host added automatic tag. Will be displayed on 'Default' device and specific device"
msgstr "Ithegi ezenzekelayo yokongezwa komamkeli. Iya kuboniswa kwisixhobo esithi 'Okungagqibekanga' nakwisixhobo esithile"

#: include/arrays.php
msgid "If checked, plugin will create automatic tags when device is added"
msgstr "Ukuba kukhethiwe, iplagini iya kudala iithegi ezizenzekelayo xa kongezwa isixhobo"

#: include/arrays.php
msgid "Host added tag color"
msgstr "Umbala wethegi wokongezwa komamkeli"

#: include/arrays.php
msgid "Device save/change automatic tag"
msgstr "Ithegi ezenzekelayo yokugcina/yokutshintsha isixhobo"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when device is saved (changed)"
msgstr "Ukuba kukhethiwe, iplagini iya kudala ithegi ezenzekelayo xa isixhobo sigcinwa (sitshintshwa)"

#: include/arrays.php
msgid "Device save/change tag color"
msgstr "Umbala wethegi wokugcina/wokutshintsha isixhobo"

#: include/arrays.php
msgid "Data source reindex automatic tag"
msgstr "Ithegi ezenzekelayo yokulungelelaniswa kwakhona komthombo wedatha"

#: include/arrays.php
msgid "Create a tag when the set of indexes returned by a device data query changes."
msgstr "Dala ithegi xa uluhlu lwezikhombisi olubuyiswa yimibuzo yedatha yesixhobo lutshintsha."

#: include/arrays.php
msgid "Data source reindex tag color"
msgstr "Umbala wethegi wokulungelelaniswa kwakhona komthombo wedatha"

#: include/arrays.php
msgid "Automatic tags - others"
msgstr "Iithegi ezizenzekelayo - ezinye"

#: include/arrays.php
msgid "Choose how to display tags listed below"
msgstr "Khetha indlela yokubonisa iithegi ezidweliswe ngezantsi"

#: include/arrays.php
msgid "For which devices will the tags below displayed?"
msgstr "Ziya kuboniswa kweziphi izixhobo iithegi ezingezantsi?"

#: include/arrays.php
msgid "Cacti version automatic tag"
msgstr "Ithegi ezenzekelayo yenguqulelo ye-Cacti"

#: include/arrays.php
msgid "If checked, plugin will create automatic tag when Cacti version is changed. Tags is for all graphs."
msgstr "Ukuba kukhethiwe, iplagini iya kudala ithegi ezenzekelayo xa inguqulelo ye-Cacti itshintshiwe. Ithegi yeyazo zonke iigrafu."

#: include/arrays.php
msgid "Cacti version tag color"
msgstr "Umbala wethegi wenguqulelo ye-Cacti"

#: include/arrays.php
msgid "Poller overrun automatic tag"
msgstr "Ithegi ezenzekelayo yokugqithisa kwexesha le-poller"

#: include/arrays.php
msgid "Create a tag when a data collector polling cycle exceeds the configured poller interval."
msgstr "Dala ithegi xa umjikelo wokuhlola womqokeleli wedatha ugqitha kwithuba le-poller elimiselweyo."

#: include/arrays.php
msgid "Poller overrun tag color"
msgstr "Umbala wethegi wokugqithisa kwexesha le-poller"

#: include/arrays.php
msgid "Data collector status automatic tags"
msgstr "Iithegi ezizenzekelayo zobume bomqokeleli wedatha"

#: include/arrays.php
msgid "Create tags when a remote data collector goes down or recovers."
msgstr "Dala iithegi xa umqokeleli wedatha okude ephuka okanye ebuya."

#: include/arrays.php
msgid "Data collector status tag color"
msgstr "Umbala wethegi wobume bomqokeleli wedatha"

#: include/arrays.php
msgid "Plugin status automatic tag"
msgstr "Ithegi ezenzekelayo yobume beplagini"

#: include/arrays.php
msgid "Create a tag when any plugin's status change (enable/disable/upgrade)"
msgstr "Dala ithegi xa ubume bayo nayiphi na iplagini butshintsha (yenza isebenze/khubaza/phucula)"

#: include/arrays.php
msgid "Plugin state tag color"
msgstr "Umbala wethegi wemeko yeplagini"

